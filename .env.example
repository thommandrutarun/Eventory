# Eventory — Environment Configuration Template
# Copy this file to .env.local for local development.
# IMPORTANT: Never commit actual secret values or .env.local to version control.

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Private Owner Management Secret (for headless owner-only template publishing)
# Provide a strong random secret key in your private .env.local
EVENTORY_OWNER_SECRET_KEY=

# Optional Figma API Access Token (for importing designs directly)
# FIGMA_ACCESS_TOKEN=
